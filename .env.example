# Optional. Without these the app runs on the local seeded repository, which is
# fully usable for development and demos.
#
# The anon key is public by design — all authorisation happens in the row level
# security policies in supabase/migrations.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
