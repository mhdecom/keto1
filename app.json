{
  "expo": {
    "name": "It's a Match",
    "slug": "its-a-match",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "itsamatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.itsamatch.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Wähle Bilder für dein Profil, damit andere einschätzen können, mit wem sie spielen.",
        "NSCameraUsageDescription": "Nimm ein Profilbild direkt mit der Kamera auf.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.itsamatch.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2C",
          "dark": {
            "backgroundColor": "#0B3D2C"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wähle Bilder für dein Profil, damit andere einschätzen können, mit wem sie spielen.",
          "cameraPermission": "Nimm ein Profilbild direkt mit der Kamera auf."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_AFTER_EAS_INIT"
      }
    },
    "owner": "REPLACE_WITH_EXPO_ACCOUNT"
  }
}
